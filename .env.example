# Dentro del VPS el host es el nombre del servicio (postgres), no localhost.
DATABASE_URL=postgresql://USUARIO:PASSWORD@postgres:5432/precios

# Token que usa n8n junto con el header X-Chat-Id (el chat de Telegram define el negocio).
SERVICE_TOKEN=

# Hosts que el endpoint MCP acepta (header Host). Agregar el dominio público si se expone.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,precios-api:*

# Solo desarrollo, sin base: token:tenant:rol separados por coma.
# DEV_TOKENS=dev-duenio:demo:duenio,dev-empleado:demo:empleado
